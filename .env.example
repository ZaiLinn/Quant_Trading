# 复制为 .env 并填写：cp .env.example .env && chmod 600 .env
# .env 已在 .gitignore 中，不会被提交

# 通知（可选）：飞书 / 钉钉 / Slack webhook，类型在配置 live.webhook_kind 中设置
QUANT_WEBHOOK_URL=

# IBKR 网关登录（使用 --profile ibkr 时需要）。先用模拟账户的用户名密码
TWS_USERID=
TWS_PASSWORD=
TRADING_MODE=paper

# 加密货币实盘（可选），变量名格式 QUANT_<交易所大写>_API_KEY / _SECRET / _PASSWORD
QUANT_BINANCE_API_KEY=
QUANT_BINANCE_SECRET=
